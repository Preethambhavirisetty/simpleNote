[mysqld]
character-set-server           = utf8mb4
collation-server               = utf8mb4_0900_ai_ci
default_time_zone              = '+00:00'
sql_mode                       = STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION,ERROR_FOR_DIVISION_BY_ZERO

# podman machine only has 2 GiB of RAM -- keep innodb modest
innodb_buffer_pool_size        = 512M
innodb_log_file_size           = 128M
innodb_flush_log_at_trx_commit = 2
innodb_strict_mode             = ON

# log payloads (data_json, value_json) can get large
max_allowed_packet             = 64M

# FULLTEXT on short agent phrases -- default min length of 3 hides too much
innodb_ft_min_token_size       = 2

[client]
default-character-set = utf8mb4
