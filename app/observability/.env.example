# Copy to backend/.env to override. Defaults match `make up`.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=devroot
MYSQL_DATABASE=agentlog

# Where the Vite dev server runs
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max log lines accepted in a single POST
LOG_BATCH_MAX=1000

# For the agent-side logger (sdk/agentlog.py)
AGENTLOG_ENDPOINT=http://127.0.0.1:8000
